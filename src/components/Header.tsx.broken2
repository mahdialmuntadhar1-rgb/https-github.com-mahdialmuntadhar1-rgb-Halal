import React, { useState, useRef, useEffect } from "react";
import { Menu, X, LogIn, LogOut, User, Shield, Settings, ChevronDown } from "lucide-react";

interface HeaderProps {
  isAuthenticated: boolean;
  isAdmin: boolean;
  onLogin: () => void;
  onLogout: () => void;
  onAdmin: () => void;
  onProfile: () => void;
  onPrivacy: () => void;
  onAccount: () => void;
  onToggleMenu: () => void;
  isMenuOpen: boolean;
  triggerToast: (msg: string) => void;
  locale: "en" | "ar" | "ku";
}

const t = {
  en: { login: "Login", logout: "Logout", profile: "Profile", admin: "Admin Panel", privacy: "Privacy", account: "Account", menu: "Menu" },
  ar: { login: "ØªØ³Ø¬ÙŠÙ„ Ø§Ù„Ø¯Ø®ÙˆÙ„", logout: "ØªØ³Ø¬ÙŠÙ„ Ø§Ù„Ø®Ø±ÙˆØ¬", profile: "Ø§Ù„Ù…Ù„Ù Ø§Ù„Ø´Ø®ØµÙŠ", admin: "Ù„ÙˆØ­Ø© Ø§Ù„Ø¥Ø¯Ø§Ø±Ø©", privacy: "Ø§Ù„Ø®ØµÙˆØµÙŠØ©", account: "Ø§Ù„Ø­Ø³Ø§Ø¨", menu: "Ø§Ù„Ù‚Ø§Ø¦Ù…Ø©" },
  ku: { login: "Ú†ÙˆÙˆÙ†Û•Ú˜ÙˆÙˆØ±Û•ÙˆÛ•", logout: "Ø¯Û•Ø±Ú†ÙˆÙˆÙ†", profile: "Ù¾Ø±Û†ÙØ§ÛŒÙ„", admin: "Ù¾Ø§Ù†ÛŽÚµÛŒ Ø¨Û•Ú•ÛŽÙˆÛ•Ø¨Û•Ø±", privacy: "ØªØ§ÛŒØ¨Û•ØªÛŒ", account: "Ù‡Û•Ú˜Ù…Ø§Ø±", menu: "Ù¾ÛŽÚ•Ø³Øª" },
};

export default function Header({ isAuthenticated, isAdmin, onLogin, onLogout, onAdmin, onProfile, onPrivacy, onAccount, onToggleMenu, isMenuOpen, locale }: HeaderProps) {
  const [dropdownOpen, setDropdownOpen] = useState(false);
  const dropdownRef = useRef<HTMLDivElement>(null);
  const text = t[locale];

  useEffect(() => {
    function handleClickOutside(event: MouseEvent) {
      if (dropdownRef.current && !dropdownRef.current.contains(event.target as Node)) {
        setDropdownOpen(false);
      }
    }
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  return (
    <header className="sticky top-0 z-50 bg-[#FDFBF7]/95 backdrop-blur-md border-b border-[#E8E2D9] shadow-sm">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex justify-between items-center h-16">
          {/* Logo */}
          <div className="flex items-center gap-3">
          </div>
          <div className="flex items-center gap-2">

        {/* Language Switcher Bar */}
        <div className="flex items-center justify-center gap-1.5 px-3 py-1.5">
          {[
            { code: 'ar' as const, flag: 'ðŸ‡¸ðŸ‡¦', label: 'Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©' },
            { code: 'ckb' as const, flag: 'ðŸ‡®ðŸ‡¶', label: 'Ú©ÙˆØ±Ø¯ÛŒ' },
            { code: 'en' as const, flag: 'ðŸ‡¬ðŸ‡§', label: 'English' }
          ].map((lang) => (
            <button
              key={lang.code}
              onClick={() => setLocale(lang.code)}
              className={`flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold transition-all duration-200
                ${locale === lang.code
                  ? 'bg-rose-50 border-2 border-rose-500 text-rose-700 shadow-sm'
                  : 'bg-white/80 border border-slate-200 text-slate-600 hover:border-amber-400 hover:text-amber-700 hover:bg-amber-50'
                }`}

              ><span className="text-base leading-none">{lang.flag}</span>
              <span>{lang.label}</span>
            </button>
          ))}
        </div>

            <div className="w-10 h-10 rounded-full bg-gradient-to-br from-[#d4a574] to-[#c49a6c] flex items-center justify-center shadow-md">
              <span className="text-white font-bold text-lg">H</span>
            </div>
            <span className="text-xl font-bold text-[#2A2A2A] tracking-tight">HALAL</span>
          </div>

          {/* Right side */}
          <div className="flex items-center gap-3">
            {/* Mobile menu button */}
            <button onClick={onToggleMenu} className="lg:hidden p-2 rounded-lg hover:bg-[#E8E2D9]/50 transition">
              {isMenuOpen ? <X className="w-5 h-5 text-[#2A2A2A]" /> : <Menu className="w-5 h-5 text-[#2A2A2A]" />}
            </button>

            {/* Login Button - BIG & VISIBLE */}
            {!isAuthenticated && (
              <button
                onClick={onLogin}
                className="flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-[#d4a574] to-[#c49a6c] text-white rounded-xl font-semibold shadow-md hover:shadow-lg hover:scale-105 transition-all duration-200"

                <LogIn className="w-4 h-4" />
                <span>{text.login}</span>
              </button>
            )}

            {/* User Dropdown - when logged in */}
            {isAuthenticated && (
              <div className="relative" ref={dropdownRef}>
                <button
                  onClick={() => setDropdownOpen(!dropdownOpen)}
                  className="flex items-center gap-2 px-4 py-2 bg-[#E8E2D9]/50 hover:bg-[#E8E2D9] rounded-xl transition-all duration-200"

                  <div className="w-8 h-8 rounded-full bg-gradient-to-br from-[#d4a574] to-[#c49a6c] flex items-center justify-center">
                    <User className="w-4 h-4 text-white" />
                  </div>
                  <ChevronDown className={`w-4 h-4 text-[#6B635B] transition-transform ${dropdownOpen ? 'rotate-180' : ''}`} />
                </button>

                {/* Dropdown Menu */}
                {dropdownOpen && (
                  <div className="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-[#E8E2D9] py-2 z-50">
                    <button onClick={() => { onProfile(); setDropdownOpen(false); }} className="w-full flex items-center gap-3 px-4 py-3 hover:bg-[#FDFBF7] transition text-left">
                      <User className="w-4 h-4 text-[#6B635B]" />
                      <span className="text-sm text-[#2A2A2A]">{text.profile}</span>
                    </button>
                    
                    {isAdmin && (
                      <button onClick={() => { onAdmin(); setDropdownOpen(false); }} className="w-full flex items-center gap-3 px-4 py-3 hover:bg-[#FDFBF7] transition text-left">
                        <Shield className="w-4 h-4 text-[#d4a574]" />
                        <span className="text-sm text-[#2A2A2A] font-medium">{text.admin}</span>
                      </button>
                    )}
                    
                    <button onClick={() => { onPrivacy(); setDropdownOpen(false); }} className="w-full flex items-center gap-3 px-4 py-3 hover:bg-[#FDFBF7] transition text-left">
                      <Settings className="w-4 h-4 text-[#6B635B]" />
                      <span className="text-sm text-[#2A2A2A]">{text.privacy}</span>
                    </button>
                    
                    <button onClick={() => { onAccount(); setDropdownOpen(false); }} className="w-full flex items-center gap-3 px-4 py-3 hover:bg-[#FDFBF7] transition text-left">
                      <Settings className="w-4 h-4 text-[#6B635B]" />
                      <span className="text-sm text-[#2A2A2A]">{text.account}</span>
                    </button>
                    
                    <div className="border-t border-[#E8E2D9] my-1"></div>
                    
                    <button onClick={() => { onLogout(); setDropdownOpen(false); }} className="w-full flex items-center gap-3 px-4 py-3 hover:bg-red-50 transition text-left">
                      <LogOut className="w-4 h-4 text-red-500" />
                      <span className="text-sm text-red-500">{text.logout}</span>
                    </button>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    </header>
  );
}
